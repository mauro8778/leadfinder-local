# ==============================================================================
# LEADFINDER LOCAL - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copiá este archivo como `.env.local` para desarrollo local o configuralo en Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (Turso Cloud SQLite / libSQL)
# ------------------------------------------------------------------------------
# Requerido para despliegue en Vercel (entorno serverless sin disco persistente).
# Obtené tus credenciales gratis con: `turso db show <nombre> --url` y `turso db tokens create <nombre>`
# En desarrollo local: si estas variables están vacías, LeadFinder usa automáticamente
# SQLite local en $DATA_DIR/leadfinder.db sin requerir configuración adicional.
TURSO_DATABASE_URL=libsql://leadfinder-tu-usuario.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQ...tu-token-aqui

# ------------------------------------------------------------------------------
# 2. NOTIFICACIONES DE WHATSAPP GRATUITAS (CallMeBot API para uso personal)
# ------------------------------------------------------------------------------
# Permite recibir alertas en tu propio WhatsApp cuando se descubran o guarden
# nuevos leads y cuando cambie de estado un lead clave en el CRM.
# 100% gratuito, sin servidores dedicados ni suscripciones de pago.
# Cómo obtener tu API key en 1 minuto:
#   1. Agregá a tus contactos el bot de CallMeBot (+34 644 10 55 84 o +34 644 84 85 41).
#   2. Enviale por WhatsApp el mensaje: "I allow callmebot to send me messages"
#   3. El bot te responderá con tu API Key personal de 6-7 dígitos.
CALLMEBOT_PHONE=5491112345678
CALLMEBOT_API_KEY=1234567

# Control fino de notificaciones (opcionales, por defecto activas si hay credenciales)
# NOTIFY_ENABLED=true
# NOTIFY_ON_NEW_LEADS=true
# NOTIFY_ON_STATUS_CHANGE=true

# ------------------------------------------------------------------------------
# 3. WEBHOOKS DE NOTIFICACIÓN ALTERNATIVOS (Opcional)
# ------------------------------------------------------------------------------
# Si deseás reenviar las notificaciones a un webhook de Discord, Slack, n8n o Zapier:
# WHATSAPP_WEBHOOK_URL=https://webhook.site/tu-id-o-discord-slack-n8n
# NOTIFY_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL SERVIDOR & ENTORNO LOCAL
# ------------------------------------------------------------------------------
# Puerto del servidor local (por defecto 4317)
PORT=4317

# Directorio de persistencia SQLite cuando no se usa Turso en local (fallback offline)
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 5. INBOX BIDIRECCIONAL WHATSAPP (Avanzado / Opcional para desarrollo local)
# ------------------------------------------------------------------------------
# Si usás Evolution API local con Docker (`docker compose -f docker-compose.whatsapp.yml up -d`):
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=leadfinder-local
EVOLUTION_INSTANCE=leadfinder

# Alternativa oficial (Meta Cloud API). Si está esto, no hace falta Evolution:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=leadfinder-local
